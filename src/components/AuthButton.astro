---
// AuthButton — Sign in with Google / user avatar. Entirely client-side.
---

<div class="auth-btn-wrapper" id="auth-btn-wrapper" aria-live="polite">
  <!-- Filled by client-side script -->
</div>

<script>
  import { authErrorMessage, hasAuthenticatedRole, observeAuth, signInWithGoogle, signOutUser } from '@/lib/auth.ts';
  import type { User } from '@firebase/auth';

  const wrapper = document.getElementById('auth-btn-wrapper')!;

  function renderUser(user: User | null) {
    wrapper.replaceChildren();
    if (user) {
      const name = user.displayName || user.email || 'User';
      const profile = document.createElement('div');
      profile.className = 'auth-user';
      if (user.photoURL) {
        try {
          const avatarUrl = new URL(user.photoURL);
          if (avatarUrl.protocol === 'https:' || avatarUrl.protocol === 'http:') {
            const avatar = document.createElement('img');
            avatar.src = avatarUrl.href;
            avatar.alt = '';
            avatar.className = 'auth-avatar';
            avatar.width = 28;
            avatar.height = 28;
            profile.append(avatar);
          }
        } catch {
          // Ignore an invalid profile image URL.
        }
      }
      if (!profile.querySelector('img')) {
        const initials = document.createElement('span');
        initials.className = 'auth-initials';
        initials.textContent = name[0]?.toUpperCase() || 'U';
        profile.append(initials);
      }
      const label = document.createElement('span');
      label.className = 'auth-name';
      label.textContent = name.split(' ')[0];
      profile.append(label);

      const signOutButton = document.createElement('button');
      signOutButton.className = 'auth-signout';
      signOutButton.setAttribute('aria-label', 'Sign out');
      signOutButton.textContent = 'Sign out';
      signOutButton.addEventListener('click', async () => {
        signOutButton.disabled = true;
        try {
          await signOutUser();
        } catch (error) {
          showError(authErrorMessage(error));
          signOutButton.disabled = false;
        }
      });
      profile.append(signOutButton);
      wrapper.append(profile);
    } else {
      const signInButton = document.createElement('button');
      signInButton.className = 'auth-signin';
      signInButton.textContent = 'Sign in';
      signInButton.addEventListener('click', async () => {
        signInButton.disabled = true;
        clearError();
        try {
          await signInWithGoogle();
        } catch (error) {
          showError(authErrorMessage(error));
          signInButton.disabled = false;
        }
      });
      wrapper.append(signInButton);
    }
  }

  const errorEl = document.createElement('span');
  errorEl.className = 'auth-error';
  errorEl.setAttribute('role', 'status');
  wrapper.after(errorEl);
  let currentUserId: string | null = null;
  function showError(message: string) { errorEl.textContent = message; }
  function clearError() { errorEl.textContent = ''; }

  try {
    observeAuth(user => {
      currentUserId = user?.uid ?? null;
      renderUser(user);
      clearError();
      window.dispatchEvent(new CustomEvent('auth-change', { detail: user }));
      if (user) {
        void hasAuthenticatedRole(user).then(hasRole => {
          if (hasRole || currentUserId !== user.uid) return;
          showError('Account data access is still being set up. Sign out and back in after setup is complete.');
        });
      }
    });
  } catch (error) {
    renderUser(null);
    showError(authErrorMessage(error));
  }
</script>

<style is:global>
  #auth-btn-wrapper {
    display: flex;
    align-items: center;
  }

  #auth-btn-wrapper .auth-signin {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: var(--text-sm);
    color: white;
    background: var(--color-accent);
    border: none;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: opacity var(--transition-fast);
    white-space: nowrap;
  }

  #auth-btn-wrapper .auth-signin:hover {
    opacity: 0.88;
  }

  #auth-btn-wrapper button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .auth-error {
    color: var(--color-text-muted);
    font-family: 'Nunito', sans-serif;
    font-size: var(--text-xs);
  }

  #auth-btn-wrapper .auth-user {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #auth-btn-wrapper .auth-avatar {
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }

  #auth-btn-wrapper .auth-initials {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #auth-btn-wrapper .auth-name {
    font-family: 'Nunito', sans-serif;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  #auth-btn-wrapper .auth-signout {
    font-family: 'Nunito', sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  #auth-btn-wrapper .auth-signout:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }
</style>
